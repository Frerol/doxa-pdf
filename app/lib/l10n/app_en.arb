{
  "@@locale": "en",
  "appTitle": "Doxa PDF",
  "@appTitle": {
    "description": "Application name. Do not translate."
  },
  "homeTagline": "A free PDF reader for studying",
  "@homeTagline": {
    "description": "Short subtitle on the placeholder home screen."
  },
  "previewNotice": "Engineering preview — nothing to see here yet.",
  "@previewNotice": {
    "description": "Notice shown while the app is only a scaffold."
  },
  "readerOpening": "Opening…",
  "@readerOpening": {
    "description": "Accessibility label of the progress indicator while a document opens."
  },
  "readerOpenFailed": "This file could not be opened.",
  "@readerOpenFailed": {
    "description": "Shown when a document is missing, damaged or not a PDF."
  },
  "readerPasswordNeeded": "This PDF is protected with a password.",
  "@readerPasswordNeeded": {
    "description": "Shown when an encrypted PDF cannot be opened without a password."
  },
  "readerZoomMenu": "Zoom",
  "@readerZoomMenu": {
    "description": "Tooltip of the reader's zoom menu."
  },
  "readerFitWidth": "Fit width",
  "@readerFitWidth": {
    "description": "Zoom menu item: pages as wide as the screen."
  },
  "readerFitPage": "Fit page",
  "@readerFitPage": {
    "description": "Zoom menu item: the whole page fits the screen."
  },
  "readerZoomFactor": "{factor}×",
