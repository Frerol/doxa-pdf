    "description": "Accessibility label of the progress indicator while a document opens."
  },
  "readerOpenFailed": "This file could not be opened.",
  "@readerOpenFailed": {
    "description": "Shown when a document is missing, damaged or not a PDF."
  },
  "readerPasswordNeeded": "This PDF is protected with a password.",
  "@readerPasswordNeeded": {
    "description": "Shown when an encrypted PDF cannot be opened without a password."
