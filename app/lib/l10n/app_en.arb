    "description": "Zoom menu item: a multiple of the fit-width zoom.",
    "placeholders": {
      "factor": {
        "type": "int"
      }
    }
  },
  "devDocumentsTitle": "PDFs in the app folder (developer)",
  "@devDocumentsTitle": {
    "description": "Title of the temporary developer list of test PDFs."
  },
  "devDocumentsRefresh": "Refresh",
  "@devDocumentsRefresh": {
    "description": "Button that lists the developer folder again."
  },
  "devDocumentsEmpty": "Copy PDFs into {path} with adb push, then refresh.",
  "@devDocumentsEmpty": {
    "description": "Shown when the developer folder has no PDFs.",
    "placeholders": {
      "path": {
        "type": "String"
      }
    }
  }
