  "searchWholeWord": "Whole words only",
  "@searchWholeWord": {
    "description": "Search option: match whole words only."
  },
  "searchIgnoreDiacritics": "Ignore accents",
  "@searchIgnoreDiacritics": {
    "description": "Search option: acao finds ação."
  },
  "selectionCopy": "Copy",
  "@selectionCopy": {
    "description": "Copies the selected text."
  },
  "selectionCopied": "Text copied.",
  "@selectionCopied": {
    "description": "Shown after the selection is copied."
  },
